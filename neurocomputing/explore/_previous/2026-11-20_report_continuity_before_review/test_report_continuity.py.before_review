    g3 = gt["G3_published_values"]
    check("G3 passes against the copies of the published code", g3["passed"],
          "; ".join(f"{k} {v['n_agree']}/{v['n']}" for k, v in g3["categories"].items()))
    check("G3 covers P1 L20, P2 square Delta20 (17 units each; mean, interval, p) and E (mean, interval, p), U20 and A20 "
