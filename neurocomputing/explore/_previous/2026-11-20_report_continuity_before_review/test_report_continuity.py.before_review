def unit_scores(rng, L, Dl, E0, Emis, Erig, noise, lnoise, luni_mean=None):
    """Per-display r_inside of a model or null: E(0) = I - C about E0, L20 = I - M about L, Delta20 = alt20 - M about
    Dl, E'_mis = M - MC about Emis, E_rig = RI - RC about Erig. luni_mean: shift MC so that mean L_uni equals it."""
    v = {}
    for c in META:
        C = 0.3 + noise * rng.randn()
        I = C + E0 + lnoise * rng.randn()
        M = I - L + lnoise * rng.randn()
        A = M + Dl + lnoise * rng.randn()
        dd = 0.002 * rng.randn()
        RC_ = 0.3 + noise * rng.randn()
        v.update({f"{c}_illusory": I, f"{c}_control180": C, f"{c}_mis20": M, f"{c}_alt20a": A + dd,
                  f"{c}_alt20b": A - dd, f"{c}_mis20_control180": M - Emis + lnoise * rng.randn(),
                  f"{c}_rig20_control180": RC_, f"{c}_rig20_illusory": RC_ + Erig + lnoise * rng.randn()})
    if luni_mean is not None:
        lu = np.mean([(v[f"{c}_illusory"] - v[f"{c}_control180"]) - (v[f"{c}_mis20"] - v[f"{c}_mis20_control180"])
                      for c in META])
        for c in META:
            v[f"{c}_mis20_control180"] += luni_mean - lu                # mean L_uni = luni_mean exactly
    return v


