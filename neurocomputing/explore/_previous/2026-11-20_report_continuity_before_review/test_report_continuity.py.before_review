# ---- copies of the published percentile code (v3/scores/analyze_alt.py summ, ratio; v2 indices), independent of analyze_re
def pub_idx(K, P):
    rng = np.random.RandomState(2026)
    return rng.randint(0, K, (10000, K)), rng.randint(0, P, (10000, K, P))


def pub_cells(shape=None):
    cells = {}
    for c, (sh, sr, pol, pos) in META.items():
        if shape is None or sh == shape:
            cells.setdefault((sh, sr, pol), []).append((pos, c))
    return [[c for _, c in sorted(cells[k])] for k in sorted(cells, key=str)]


def pub_bmeans(vals):
    ci, pi = pub_idx(*vals.shape)
    return vals[ci[:, :, None], pi].mean((1, 2))


def pub_summ(vals):
    bm = pub_bmeans(vals)
    lo, hi = np.percentile(bm, [2.5, 97.5])
    p = min(1.0, 2 * min(np.mean(bm <= 0), np.mean(bm >= 0)))
    return dict(mean=round(float(vals.mean()), 4), ci=[round(float(lo), 4), round(float(hi), 4)], p=float(p))


def pub_ratio(num, den):
    bn, bd = pub_bmeans(num), pub_bmeans(den)
    with np.errstate(divide="ignore", invalid="ignore"):
        br = bn / bd
    lo, hi = np.nanpercentile(br, [2.5, 97.5])
    return dict(value=round(float(num.mean() / den.mean()), 4), ci=[round(float(lo), 4), round(float(hi), 4)])


def unit_val(v, c, cond):
    return 0.5 * (v[f"{c}_{cond}a"] + v[f"{c}_{cond}b"]) if cond == "alt20" else v[f"{c}_{cond}"]


def pub_arr(v, cells, test, ctrl):
    return np.array([[unit_val(v, c, test) - unit_val(v, c, ctrl) for c in cell] for cell in cells])


def head_val(fs, ar, c, cond):
    return np.mean([unit_val(SYN_HEAD[(fs, ar)][s][z], c, cond) for s in (0, 1, 2) for z in ("336", "448")])


def build_published():
    allc, sq = pub_cells(), pub_cells("square")
    models = {}
    for name, v in list(SYN_MODEL.items()) + [("null " + k, v) for k, v in SYN_NULL.items()]:
        models[name] = {"results": {"r_inside": {"all": {"drop_uni": {"20": pub_summ(pub_arr(v, allc, "illusory", "mis20"))}},
                                                 "square": {"alt_minus_mis": {"20": pub_summ(pub_arr(v, sq, "alt20", "mis20"))}}}}}
    json.dump(dict(models=models), open(RC.PATHS["v3_results"], "w"))
    full = dict(stim_v3={}, stim_alt={})
    for (fs, ar) in HEADS:
        arr = lambda cond: np.array([[head_val(fs, ar, c, cond) for c in cell] for cell in allc])   # noqa: E731
        ill, c180, mis, alt = arr("illusory"), arr("control180"), arr("mis20"), arr("alt20")
        full["stim_v3"].setdefault(fs, {})[ar] = {"kanizsa": {"illusory-control180": {"avg|r_inside": pub_summ(ill - c180)}}}
        full["stim_alt"].setdefault(fs, {})[ar] = {"r_inside": {"ratio_uni20": pub_ratio(mis - c180, ill - c180),
                                                                "ratio_alt20": pub_ratio(alt - c180, ill - c180)}}
    json.dump(full, open(RC.PATHS["full_results"], "w"))


