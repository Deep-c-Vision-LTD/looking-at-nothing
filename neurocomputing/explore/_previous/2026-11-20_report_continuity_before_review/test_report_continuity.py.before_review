    # 2. designs: the published indices
    check("pooled design 12 x 5 and square design 6 x 5", (D.K, D.P, DSQ.K, DSQ.P) == (12, 5, 6, 5))
    pi12, pi6 = pub_idx(12, 5), pub_idx(6, 5)
    check("Design indices equal the published RandomState(2026) draws (pooled and square)",
          np.array_equal(D.idx[0], pi12[0]) and np.array_equal(D.idx[1], pi12[1]) and
          np.array_equal(DSQ.idx[0], pi6[0]) and np.array_equal(DSQ.idx[1], pi6[1]))

    # 3. pct_ratio_diff
    rng = np.random.RandomState(5)
    n1, d1 = 0.07 + 0.01 * rng.randn(12, 5), 0.10 + 0.01 * rng.randn(12, 5)
    n2, d2 = 0.08 + 0.01 * rng.randn(12, 5), 0.11 + 0.01 * rng.randn(12, 5)
    z = np.zeros((12, 5))
    r0, pr = RC.pct_ratio_diff(n1, d1, z, d2, D.idx), AR.pct_ratio(n1, d1, D.idx)
    check("pct_ratio_diff with a zero second numerator equals analyze_re.pct_ratio exactly",
          r0["value"] == pr["value"] and r0["ci"] == pr["ci"])
    rd = RC.pct_ratio_diff(n1, d1, n2, d2, D.idx)
    bd = pub_bmeans(n1) / pub_bmeans(d1) - pub_bmeans(n2) / pub_bmeans(d2)
    lo, hi = np.nanpercentile(bd, [2.5, 97.5])
    check("pct_ratio_diff equals the percentile interval of the difference of two independently resampled ratios",
          abs(rd["ci"][0] - lo) < 1e-12 and abs(rd["ci"][1] - hi) < 1e-12)
    check("pct_ratio_diff value is the difference of the ratios of means (as analyze_re.p4)",
          rd["value"] == float(n1.mean() / d1.mean() - n2.mean() / d2.mean()))
    rr = RC.pct_ratio_diff(n2, d2, n1, d1, D.idx)
    check("pct_ratio_diff is antisymmetric", abs(rr["ci"][0] + rd["ci"][1]) < 1e-12 and abs(rr["ci"][1] + rd["ci"][0]) < 1e-12)
    check("pct_ratio_diff gives no p and counts resamples on each side of 0",
          "p" not in rd and rd["n_below_0"] + rd["n_at_0"] + rd["n_above_0"] == 10000 - rd["n_nan"])
    stat = lambda a_, b_, c_, d_: a_ / b_ - c_ / d_                       # noqa: E731  (the statistic of analyze_re.p4)
    bt = np.asarray(stat(*[AR.bmeans(x, D.idx) for x in (n1, d1, n2, d2)]), float)
    bt = bt[np.isfinite(bt)]                                              # as analyze_re.bca
    bq = np.quantile(bt, [0.025, 0.975])
    bc = AR.bca(stat, [n1, d1, n2, d2], D.idx, theta0=0.0)
    check("pct_ratio_diff = 2.5 and 97.5 percentiles of the bootstrap distribution behind analyze_re.bca (no adjustment)",
          abs(rd["ci"][0] - bq[0]) < 1e-12 and abs(rd["ci"][1] - bq[1]) < 1e-12 and bc["B"] == 10000 - rd["n_nan"]
          and bc["value"] == rd["value"], f"BCa {bc['ci']} against unadjusted {rd['ci']}")
    big = RC.pct_ratio_diff(n1 + 0.05, d1, n2, d2, D.idx)
    check("a difference with every resample above 0 is flagged (the BCa p is then set by the clip, D4)",
          big["zero_outside_every_resample"] and not rd["zero_outside_every_resample"],
          f"{big['n_below_0']} below; weak case {rd['n_below_0']} below, {rd['n_above_0']} above")

    # 4. linearity: a model-minus-null interval is the interval of the difference of the two bootstrap distributions
    av, bv = 0.05 + 0.02 * rng.randn(12, 5), 0.01 * rng.randn(12, 5)
    pc = AR.pct_summary(av - bv, D.idx)
    lo, hi = np.percentile(pub_bmeans(av) - pub_bmeans(bv), [2.5, 97.5])
    check("pct_summary of a difference = percentile of the difference of the two published bootstrap distributions",
          abs(pc["ci"][0] - lo) < 1e-12 and abs(pc["ci"][1] - hi) < 1e-12)

    # 5. synthetic inputs and stored files
    write_items()
    build_models_nulls()
    build_heads()
    build_primary()
    build_published()
    build_p6_reporting()
    out(f"synthetic inputs written ({time.time() - t0:.1f}s)")
    check("configs_meta reads the synthetic items (60 configurations)", AR.configs_meta() == META)

    # 6. full run on synthetic inputs
    t1 = time.time()
