    doc = RC.__doc__
    check("header lists implementation choices (a) to (k)", all(f"  ({c}) " in doc for c in "abcdefghijk"))
    check("header quotes rule 4.5 verbatim", "Continuity: the published two-stage percentile intervals are reported in "
          "the supplement for every\n  primary estimate." in doc)
    check("only a missing stored field (KeyError) is reported as one", "except KeyError" in src and
          "except (KeyError, TypeError)" not in src and "except Exception" not in src)
